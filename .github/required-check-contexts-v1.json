{
  "schema": "heptatrader.required-check-contexts.v1",
  "policy": {
    "explicit_job_names": true,
    "globally_unique_contexts": true,
    "dynamic_context_expressions": "matrix-only",
    "required_contexts_must_be_event_reachable": true,
    "skipped_or_missing_is_not_success": true,
    "merge_group_cancel_in_progress": "forbidden"
  },
  "required_branch_contexts": [
    "documentation-control-plane-exact-head",
    "core-runtime-exact-head",
    "canonical-full-suite-core",
    "canonical-full-suite-reliability (g++)",
    "canonical-full-suite-reliability (clang++)",
    "exact-merge-candidate"
  ],
  "required_pull_request_contexts": [
    "documentation-control-plane-exact-head",
    "core-runtime-exact-head",
    "canonical-full-suite-core",
    "canonical-full-suite-reliability (g++)",
    "canonical-full-suite-reliability (clang++)",
    "exact-merge-candidate"
  ],
  "required_merge_group_contexts": [
    "documentation-control-plane-exact-head",
    "core-runtime-exact-head",
    "canonical-full-suite-core",
    "canonical-full-suite-reliability (g++)",
    "canonical-full-suite-reliability (clang++)",
    "exact-merge-candidate"
  ],
  "external_qualification_contexts": [
    "github-governance-exact-artifact-verification",
    "ib-paper-exact-artifact-qualification"
  ],
  "non_required_observation_contexts": [
    "github-governance-workflow-bootstrap-audit",
    "ib-paper-workflow-bootstrap-audit",
    "reliability-runtime-sanitizers (g++)",
    "reliability-runtime-sanitizers (clang++)",
    "release-candidate-reproducibility-observation",
    "X230 IB runner probe"
  ]
}
