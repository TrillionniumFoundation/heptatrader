# IB Advanced Scheduler 30-minute stress profile (P2)
# Safe defaults: keeps order gate OFF unless explicitly enabled.

# ---- baseline ----
HEPTA_PROFILE=paper
HEPTA_IB_ADV_SCHEDULER=1
HEPTA_IB_ADV_OBS=1
HEPTA_IB_STEADY_SIGNAL_CLOCK=1

# ---- scheduler scoring ----
# score = (signal_weight * signal_strength) / (1 + risk_weight * risk_cost)
HEPTA_IB_ADV_SCHED_SIGNAL_WEIGHT=1.20
HEPTA_IB_ADV_SCHED_RISK_WEIGHT=1.80

# ---- scheduler/queue budgets ----
HEPTA_IB_ADV_SCHED_RISK_BUDGET_QTY=3000
HEPTA_IB_ADV_SCHED_ENQUEUE_BUDGET_PER_LOOP=8
HEPTA_IB_ASYNC_PLACE_BUDGET=5
HEPTA_IB_ADV_SCHED_MIN_PLACE_BUDGET=2
HEPTA_IB_ADV_SCHED_MAX_PLACE_BUDGET=5
HEPTA_IB_ADV_SCHED_QUEUE_PRESSURE=0.70
HEPTA_IB_ASYNC_QUEUE_CAPACITY=512

# ---- diagnostics ----
HEPTA_IB_ASYNC_LOG_INTERVAL_MS=1000
HEPTA_IB_DIAG_SAMPLE_MS=2000
HEPTA_IB_STRATEGY_SUMMARY_SEC=10

# ---- hard safety limits ----
HEPTA_ALLOW_IB_ORDERS=0
HEPTA_ALLOW_IB_LIVE=0
HEPTA_IB_LIVE_KILL_SWITCH=1
HEPTA_GLOBAL_KILL_SWITCH=0
HEPTA_IB_MAX_ORDER_QTY=1000
HEPTA_IB_MAX_DAILY_ORDERS=200
