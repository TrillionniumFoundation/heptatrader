#!/usr/bin/env bash
set -euo pipefail
export HEPTA_TOOL_SOCKET="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/heptatrader/tools.sock"
export HEPTA_TOOL_SESSION_TOKEN_FILE="$HOME/.config/heptatrader/paper.token"
export HEPTA_TOOL_EXPECTED_UID="$(id -u)"
exec /usr/bin/python3 -I "$HOME/.local/share/heptatrader/current/libexec/heptatrader/hepta_mcp_server.py"
