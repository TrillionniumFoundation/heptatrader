#!/usr/bin/env bash
set -euo pipefail
prefix="$HOME/.local/share/heptatrader/current"
config="$HOME/.config/heptatrader"
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/heptatrader"
case "${1:-status}" in
  start|restart|stop)
    exec systemctl --user "$1" heptatrader.target ;;
  status)
    systemctl --user --no-pager status heptatrader-execution.service heptatrader-gateway.service
    if [[ -e "$runtime/control/kill-switch" ]]; then echo 'PAPER guard: engaged'; else echo 'PAPER guard: not engaged (service readiness still required)'; fi ;;
  logs)
    exec journalctl --user -u heptatrader-execution.service -u heptatrader-gateway.service -n 60 --no-pager ;;
  native)
    shift; exec "$prefix/bin/heptactl" --socket "$runtime/tools.sock" --token-file "$config/paper.token" "$@" ;;
  session)
    shift; exec "$prefix/bin/hepta-sessionctl" --socket "$runtime/supervisor.sock" "$@" ;;
  ask)
    shift
    if [[ $# -ne 1 ]]; then echo 'usage: heptatrader ask "instruction"' >&2; exit 64; fi
    model=gpt-6-luna
    [[ ! -f "$config/model" ]] || read -r model < "$config/model"
    cli="$HOME/.local/share/heptatrader/tools/node_modules/.bin/codex"
    [[ -x "$cli" ]] || { echo 'Codex CLI is not installed in the user tools directory' >&2; exit 69; }
    work="$HOME/.local/state/heptatrader/agent-workspace"
    mkdir -p "$work"; chmod 700 "$work"
    exec "$cli" -a never exec --ignore-user-config --ephemeral --skip-git-repo-check \
      --sandbox read-only --model "$model" --cd "$work" \
      --disable shell_tool --disable unified_exec --disable apps --disable skill_mcp_dependency_install \
      -c 'web_search="disabled"' \
      -c "mcp_servers.heptatrader.command=\"$prefix/libexec/heptatrader/hepta-user-mcp\"" \
      "You operate only the configured local IB PAPER simulator through the HeptaTrader MCP tools. Never request LIVE or change credentials, configuration, risk limits or kill switch. Obtain current tool schemas and authoritative state before acting. A lost or uncertain send must be inspected under its original command ID, never resent as a new order. A quoted price or accepted request is not a fill. Do not place any order unless this user instruction explicitly asks for one. User instruction: $1" < /dev/null ;;
  *)
    echo 'usage: heptatrader {start|restart|stop|status|logs|native <args>|session <args>|ask "instruction"}' >&2
    exit 64 ;;
esac
