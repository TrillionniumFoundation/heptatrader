#!/usr/bin/env bash
set -euo pipefail
prefix="$HOME/.local/share/heptatrader/current"
config="$HOME/.config/heptatrader"
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/heptatrader"
# PnL is a read-only observer, never the driver's legacy realized-only counter.
pnl_report() {
  local script="$prefix/libexec/heptatrader/hepta_pnl_report.py"
  local selected="$HOME/.local/share/heptatrader/pnl-current/hepta_pnl_report.py"
  [[ ! -f "$selected" ]] || script="$selected"
  if [[ ! -f "$script" ]]; then
    echo 'PnL UNKNOWN: install the PnL observer and attach an explicit accounting period.' >&2
    return 69
  fi
  /usr/bin/python3 -B "$script" "$@"
}
progress_report() {
  local script="$(dirname "$(readlink -f "$0")")/hepta_progress.py"
  [[ -f "$script" ]] || script="$prefix/libexec/heptatrader/hepta_progress.py"
  if [[ ! -f "$script" ]]; then
    echo 'Progress UNKNOWN: the read-only progress observer is not installed.' >&2
    return 69
  fi
  /usr/bin/python3 -B "$script" "$@"
}
maintenance_driver_ready() {
  local unit="$1" snapshot key value
  if systemctl --user is-active --quiet "$unit"; then return 0; fi
  snapshot="$(systemctl --user show "$unit" --no-pager \
    -p LoadState -p ActiveState -p UnitFileState -p MainPID -p RefuseManualStop)" || return 1
  local -A fields=()
  while IFS='=' read -r key value; do
    case "$key" in LoadState|ActiveState|UnitFileState|MainPID|RefuseManualStop) ;; *) return 1 ;; esac
    [[ -z "${fields[$key]+present}" ]] || return 1
    fields["$key"]="$value"
  done <<< "$snapshot"
  [[ ${#fields[@]} == 5 && ${fields[LoadState]-} == loaded && ${fields[ActiveState]-} == inactive \
     && ${fields[UnitFileState]-} == disabled && ${fields[MainPID]-} == 0 \
     && ${fields[RefuseManualStop]-} == yes ]]
}
case "${1:-status}" in
  progress)
    shift; progress_report "$@" ;;
  pnl)
    shift; pnl_report "$@" ;;
  training-pause)
    shift
    helper="$(dirname "$(readlink -f "$0")")/hepta_laya_pause.py"
    exec /usr/bin/python3 -B "$helper" "$@" ;;
  start|restart|stop)
    exec systemctl --user "$1" heptatrader.target ;;
  status)
    service_status=0
    systemctl --user --no-pager status heptatrader-execution.service heptatrader-gateway.service || service_status=$?
    if [[ -e "$runtime/control/kill-switch" ]]; then echo 'PAPER guard: engaged'; else echo 'PAPER guard: not engaged (service readiness still required)'; fi
    progress_report || true
    pnl_report --cached || true
    exit "$service_status" ;;
  pause|paper-on|maintenance-hold|maintenance-release|maintenance-status)
    # Resident Drivers may invoke paper-on automatically. They cannot clear
    # a persistent operator maintenance hold. Native risk checks are unchanged.
    if [[ "$1" == paper-on ]]; then
      systemctl --user is-active --quiet heptatrader-execution.service heptatrader-gateway.service
    fi
    if [[ "$1" == maintenance-release ]]; then
      for unit in heptatrader-execution.service heptatrader-gateway.service; do
        systemctl --user is-active --quiet "$unit"
      done
      for unit in heptatrader-paper-driver.service heptatrader-crypto-driver.service; do
        if ! maintenance_driver_ready "$unit"; then
          echo "maintenance-release blocked: driver is neither active nor safely disabled: $unit" >&2
          exit 75
        fi
      done
    fi
    helper="$(dirname "$(readlink -f "$0")")/hepta_maintenance_latch.py"
    exec /usr/bin/python3 -B "$helper" "$@"
    ;;
  logs)
    exec journalctl --user -u heptatrader-execution.service -u heptatrader-gateway.service -n 60 --no-pager ;;
  native)
    shift; exec "$prefix/bin/heptactl" --socket "$runtime/tools.sock" --token-file "$config/paper.token" "$@" ;;
  session)
    shift; exec "$prefix/bin/hepta-sessionctl" --socket "$runtime/supervisor.sock" "$@" ;;
  ask)
    shift
    if [[ $# -ne 1 ]]; then echo 'usage: heptatrader ask "instruction"' >&2; exit 64; fi
    model=gpt-6-luna
    [[ ! -f "$config/model" ]] || read -r model < "$config/model"
    cli="$HOME/.local/share/heptatrader/tools/node_modules/.bin/codex"
    [[ -x "$cli" ]] || { echo 'Codex CLI is not installed in the user tools directory' >&2; exit 69; }
    work="$HOME/.local/state/heptatrader/agent-workspace"
    mkdir -p "$work"; chmod 700 "$work"
    exec "$cli" -a never exec --ignore-user-config --ephemeral --skip-git-repo-check \
      --sandbox read-only --model "$model" --cd "$work" \
      --disable shell_tool --disable unified_exec --disable apps --disable skill_mcp_dependency_install \
      -c 'web_search="disabled"' \
      -c "mcp_servers.heptatrader.command=\"$prefix/libexec/heptatrader/hepta-user-mcp\"" \
      "You operate only the configured local IB PAPER simulator through the HeptaTrader MCP tools. Never request LIVE or change credentials, configuration, risk limits or kill switch. Obtain current tool schemas and authoritative state before acting. Use exact unqualified catalog names for tool_name, for example market.get_quote, without the heptatrader server prefix. A lost or uncertain send must be inspected under its original command ID, never resent as a new order. A quoted price or accepted request is not a fill. Do not place any order unless this user instruction explicitly asks for one. User instruction: $1" < /dev/null ;;
  *)
    echo 'usage: heptatrader {start|restart|stop|status|progress [--format json|--value-timing-report FILE]|pnl [--account|--format json|--cached|--import-flex FILE --statement-timezone ZONE]|logs|pause|training-pause|paper-on [--resume-native-hold [--check]]|maintenance-hold|maintenance-release [--expected-hold-sha256 SHA256]|maintenance-status|native <args>|session <args>|ask "instruction"}' >&2
    exit 64 ;;
esac
