#!/usr/bin/env python3
"""Relocatable legacy Tick consumer; uses this SDK's compiled bar engine."""
from pathlib import Path
import sys
bindir = Path(__file__).resolve().parent
sys.path.insert(0, str((bindir / "@HEPTA_RESEARCH_PYTHON_RELATIVE@").resolve()))
from hepta_research.legacy_ticks import main
raise SystemExit(main(default_bars=bindir / "hepta-research-bars"))
