#!/bin/sh

# This entry point is intentionally small.  It is allowed to make exactly one
# mount-table change: remount the container's private cgroup-v2 mount read/write
# so that systemd PID 1 can create its own delegated child cgroups.

set -eu

fail()
{
    printf '%s\n' "hepta rootful systemd entrypoint: fail-closed" >&2
    exit 125
}

[ "$(id -u)" = "0" ] || fail
[ "$$" = "1" ] || fail
[ "${HEPTA_ROOTFUL_GATE_DISPOSABLE:-}" = "1" ] || fail

case "${HEPTA_ROOTFUL_GATE_MODE:-}" in
    real|sandbox|stub) ;;
    *) fail ;;
esac

gate_run_id="${HEPTA_ROOTFUL_GATE_RUN_ID:-}"
if [ -z "$gate_run_id" ]; then
    gate_run_id="$(tr -d '-' </proc/sys/kernel/random/uuid)" || fail
fi
case "$gate_run_id" in
    *[!0-9a-f]*|'') fail ;;
esac
[ "${#gate_run_id}" -eq 32 ] || fail

[ ! -S /run/docker.sock ] || fail
[ ! -S /var/run/docker.sock ] || fail
[ -r /sys/fs/cgroup/cgroup.controllers ] || fail
[ "$(cat /proc/1/cgroup)" = "0::/" ] || fail

# Refuse a non-cgroup2 target or an unexpected mountpoint before remounting it.
cgroup_mount="$({ findmnt -rn -T /sys/fs/cgroup -o FSTYPE,TARGET,FSROOT; } 2>/dev/null)" || fail
set -- $cgroup_mount
[ "$#" -eq 3 ] || fail
[ "$1" = "cgroup2" ] || fail
[ "$2" = "/sys/fs/cgroup" ] || fail
cgroup_root="$3"
case "$cgroup_root" in
    /) ;;
    /system.slice/docker-*.scope)
        cgroup_id="${cgroup_root#/system.slice/docker-}"
        cgroup_id="${cgroup_id%.scope}"
        [ "${#cgroup_id}" -eq 64 ] || fail
        case "$cgroup_id" in *[!0-9a-f]*) fail;; esac
        ;;
    *) fail ;;
esac

mount -o remount,rw,nosuid,nodev,noexec /sys/fs/cgroup || fail
cgroup_options="$({ findmnt -rn -T /sys/fs/cgroup -o OPTIONS; } 2>/dev/null)" || fail
case ",$cgroup_options," in
    *,rw,*) ;;
    *) fail ;;
esac

# A private namespace rooted at 0::/ must permit creation of an owned child.
# Never write controller settings or move a task as part of this probe.
probe_cgroup="/sys/fs/cgroup/hepta-entrypoint-probe"
[ ! -e "$probe_cgroup" ] || fail
mkdir "$probe_cgroup" || fail
rmdir "$probe_cgroup" || fail

umask 077
sentinel=/run/hepta-rootful-systemd-gate.disposable
[ ! -e "$sentinel" ] || fail
printf '%s\n' "$gate_run_id" >"$sentinel" || fail
chown 0:0 "$sentinel" || fail
chmod 0400 "$sentinel" || fail

exec /usr/lib/systemd/systemd \
    --unit=hepta-rootful-systemd-gate.target \
    --show-status=no
