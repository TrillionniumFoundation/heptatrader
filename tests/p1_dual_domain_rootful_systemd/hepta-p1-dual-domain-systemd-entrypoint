#!/bin/sh

set -eu

fail()
{
    printf '%s\n' "hepta P1 dual-domain entrypoint: fail-closed" >&2
    exit 125
}

[ "$(id -u)" = "0" ] || fail
[ "$$" = "1" ] || fail
[ "${HEPTA_P1_DUAL_DOMAIN_DISPOSABLE:-}" = "1" ] || fail
run_id="${HEPTA_P1_DUAL_DOMAIN_RUN_ID:-}"
[ "${#run_id}" -eq 32 ] || fail
case "$run_id" in *[!0-9a-f]*|'') fail;; esac

[ ! -S /run/docker.sock ] || fail
[ ! -S /var/run/docker.sock ] || fail
[ -r /sys/fs/cgroup/cgroup.controllers ] || fail
[ "$(cat /proc/1/cgroup)" = "0::/" ] || fail

cgroup_mount="$({ findmnt -rn -T /sys/fs/cgroup -o FSTYPE,TARGET,FSROOT; } \
    2>/dev/null)" || fail
set -- $cgroup_mount
[ "$#" -eq 3 ] || fail
[ "$1" = "cgroup2" ] || fail
[ "$2" = "/sys/fs/cgroup" ] || fail
case "$3" in
    /) ;;
    /system.slice/docker-*.scope)
        cgroup_id="${3#/system.slice/docker-}"
        cgroup_id="${cgroup_id%.scope}"
        [ "${#cgroup_id}" -eq 64 ] || fail
        case "$cgroup_id" in *[!0-9a-f]*) fail;; esac
        ;;
    *) fail ;;
esac

mount -o remount,rw,nosuid,nodev,noexec /sys/fs/cgroup || fail
case ",$(findmnt -rn -T /sys/fs/cgroup -o OPTIONS)," in
    *,rw,*) ;;
    *) fail ;;
esac
probe=/sys/fs/cgroup/hepta-p1-dual-domain-entrypoint-probe
[ ! -e "$probe" ] || fail
mkdir "$probe" || fail
rmdir "$probe" || fail

for path in /etc/heptatrader /run /var/lib; do
    [ "$(findmnt -rn -T "$path" -o FSTYPE,TARGET)" = "tmpfs $path" ] || fail
done

install -d -o 0 -g 0 -m 0755 /etc/heptatrader
install -d -o 0 -g 0 -m 0711 /etc/heptatrader/credentials
install -d -o 0 -g 0 -m 0711 /etc/heptatrader/credentials/watch
install -d -o 0 -g 0 -m 0711 /etc/heptatrader/credentials/paper
install -o 0 -g 0 -m 0444 \
    /opt/hepta-p1-dual/provision/identities.json \
    /etc/heptatrader/p1-dual-domain-identities.json
install -o 0 -g 0 -m 0444 \
    /opt/hepta-p1-dual/provision/boundary.json \
    /etc/heptatrader/p1-dual-domain-boundary.json

install -d -o 0 -g 0 -m 0755 /run/hepta-p1-dual
install -d -o 0 -g 0 -m 0711 /run/hepta-p1-dual/control

for domain in codex-a openclaw-b; do
    case "$domain" in
        codex-a)
            watch_gid=2211
            paper_gid=2231
            ;;
        openclaw-b)
            watch_gid=2212
            paper_gid=2232
            ;;
        *) fail ;;
    esac
    install -d -o 0 -g "$watch_gid" -m 0750 \
        "/etc/heptatrader/credentials/watch/$domain"
    install -o 0 -g "$watch_gid" -m 0440 \
        "/opt/hepta-p1-dual/provision/watch-$domain.credential" \
        "/etc/heptatrader/credentials/watch/$domain/lease.fixture"

    install -d -o 0 -g "$paper_gid" -m 0750 \
        "/etc/heptatrader/credentials/paper/$domain"
    install -o 0 -g "$paper_gid" -m 0440 \
        "/opt/hepta-p1-dual/provision/paper-$domain.credential" \
        "/etc/heptatrader/credentials/paper/$domain/authorization.fixture"
    install -d -o 0 -g "$paper_gid" -m 0750 \
        "/run/hepta-p1-dual/control/paper-$domain"
    printf '%s\n' engaged \
        >"/run/hepta-p1-dual/control/paper-$domain/kill-switch"
    chown 0:"$paper_gid" \
        "/run/hepta-p1-dual/control/paper-$domain/kill-switch"
    chmod 0440 \
        "/run/hepta-p1-dual/control/paper-$domain/kill-switch"
done

sentinel=/run/hepta-p1-dual-domain-rootful.disposable
[ ! -e "$sentinel" ] || fail
printf '%s\n' "$run_id" >"$sentinel"
chown 0:0 "$sentinel"
chmod 0400 "$sentinel"

exec /usr/lib/systemd/systemd \
    --unit=hepta-p1-dual-domain-rootful.target \
    --show-status=no
