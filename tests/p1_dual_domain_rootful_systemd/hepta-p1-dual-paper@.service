[Unit]
Description=HeptaTrader P1 fixture inert PAPER service (%i)
Requires=hepta-p1-dual-paper@%i.socket
After=hepta-p1-dual-paper@%i.socket
StartLimitIntervalSec=30s
StartLimitBurst=8

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=1s
User=hepta-p1-paper-%i
Group=hepta-p1-paper-%i
SupplementaryGroups=
Sockets=hepta-p1-dual-paper@%i.socket
ExecStart=/usr/bin/python3 -I -S /usr/libexec/hepta-p1-dual-domain-daemon --serve --plane PAPER_INERT --domain %i
ExecStopPost=/usr/bin/python3 -I -S /usr/libexec/hepta-p1-dual-domain-daemon --cleanup --plane PAPER_INERT --domain %i
LoadCredential=fixture:/etc/heptatrader/credentials/paper/%i/authorization.fixture
Environment=HEPTA_P1_PAPER_AUTHORIZED=0
Environment=HEPTA_P1_LIVE_AUTHORIZED=0
Environment=HEPTA_P1_MUTATION_AUTHORIZED=0
Environment=HEPTA_P1_DIRECT_BROKER_ACCESS=0
RuntimeDirectory=hepta-p1-paper-%i
RuntimeDirectoryMode=0700
StateDirectory=hepta-p1-paper-%i
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=100ms
TimeoutStartSec=10s
TimeoutStopSec=5s
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/run/hepta-p1-paper-%i /var/lib/hepta-p1-paper-%i
ReadOnlyPaths=/run/hepta-p1-dual/control/paper-%i

# Fixture-only and deliberately not installable.
