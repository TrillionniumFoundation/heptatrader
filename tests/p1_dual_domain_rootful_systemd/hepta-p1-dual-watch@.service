[Unit]
Description=HeptaTrader P1 fixture WATCH service (%i)
Requires=hepta-p1-dual-watch@%i.socket
After=hepta-p1-dual-watch@%i.socket
StartLimitIntervalSec=30s
StartLimitBurst=8

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=1s
User=hepta-p1-watch-%i
Group=hepta-p1-watch-%i
SupplementaryGroups=
Sockets=hepta-p1-dual-watch@%i.socket
ExecStart=/usr/bin/python3 -I -S /usr/libexec/hepta-p1-dual-domain-daemon --serve --plane WATCH --domain %i
ExecStopPost=/usr/bin/python3 -I -S /usr/libexec/hepta-p1-dual-domain-daemon --cleanup --plane WATCH --domain %i
LoadCredential=fixture:/etc/heptatrader/credentials/watch/%i/lease.fixture
RuntimeDirectory=hepta-p1-watch-%i
RuntimeDirectoryMode=0700
StateDirectory=hepta-p1-watch-%i
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=100ms
TimeoutStartSec=10s
TimeoutStopSec=5s
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/run/hepta-p1-watch-%i /var/lib/hepta-p1-watch-%i

# Fixture-only and deliberately not installable.
