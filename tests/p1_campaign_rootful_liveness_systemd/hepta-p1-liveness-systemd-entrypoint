#!/bin/sh

set -eu

fail()
{
    printf '%s\n' "hepta P1 liveness entrypoint: fail-closed" >&2
    exit 125
}

[ "$(id -u)" = "0" ] || fail
[ "$$" = "1" ] || fail
[ "${HEPTA_P1_LIVENESS_DISPOSABLE:-}" = "1" ] || fail
run_id="${HEPTA_P1_LIVENESS_RUN_ID:-}"
[ "${#run_id}" -eq 32 ] || fail
case "$run_id" in *[!0-9a-f]*|'') fail;; esac
[ ! -S /run/docker.sock ] || fail
[ ! -S /var/run/docker.sock ] || fail
[ -r /sys/fs/cgroup/cgroup.controllers ] || fail
[ "$(cat /proc/1/cgroup)" = "0::/" ] || fail

cgroup_mount="$({ findmnt -rn -T /sys/fs/cgroup -o FSTYPE,TARGET,FSROOT; } \
    2>/dev/null)" || fail
set -- $cgroup_mount
[ "$#" -eq 3 ] || fail
[ "$1" = "cgroup2" ] || fail
[ "$2" = "/sys/fs/cgroup" ] || fail
case "$3" in
    /) ;;
    /system.slice/docker-*.scope)
        cgroup_id="${3#/system.slice/docker-}"
        cgroup_id="${cgroup_id%.scope}"
        [ "${#cgroup_id}" -eq 64 ] || fail
        case "$cgroup_id" in *[!0-9a-f]*) fail;; esac
        ;;
    *) fail ;;
esac

mount -o remount,rw,nosuid,nodev,noexec /sys/fs/cgroup || fail
case ",$(findmnt -rn -T /sys/fs/cgroup -o OPTIONS)," in
    *,rw,*) ;;
    *) fail ;;
esac
probe=/sys/fs/cgroup/hepta-p1-liveness-entrypoint-probe
[ ! -e "$probe" ] || fail
mkdir "$probe" || fail
rmdir "$probe" || fail

for path in /run /var/lib; do
    [ "$(findmnt -rn -T "$path" -o FSTYPE,TARGET)" = "tmpfs $path" ] || fail
done

install -d -o 0 -g 0 -m 0700 /run/hepta-p1-liveness
install -d -o 0 -g 0 -m 0700 /var/lib/hepta-p1-liveness
install -d -o 0 -g 0 -m 0700 \
    /var/lib/hepta-p1-liveness/worker-journal \
    /var/lib/hepta-p1-liveness/coordinator-journal
sentinel=/run/hepta-p1-campaign-rootful-liveness.disposable
[ ! -e "$sentinel" ] || fail
printf '%s\n' "$run_id" >"$sentinel"
chown 0:0 "$sentinel"
chmod 0400 "$sentinel"

exec /usr/lib/systemd/systemd \
    --unit=hepta-p1-campaign-rootful-liveness.target \
    --show-status=no
