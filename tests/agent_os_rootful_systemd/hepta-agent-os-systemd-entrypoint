#!/bin/sh

set -eu

fail()
{
    printf '%s\n' "hepta Agent OS E2E entrypoint: fail-closed" >&2
    exit 125
}

[ "$(id -u)" = "0" ] || fail
[ "$$" = "1" ] || fail
[ "${HEPTA_AGENT_OS_E2E_DISPOSABLE:-}" = "1" ] || fail

run_id="${HEPTA_AGENT_OS_E2E_RUN_ID:-}"
[ "${#run_id}" -eq 32 ] || fail
case "$run_id" in *[!0-9a-f]*|'') fail;; esac

[ ! -S /run/docker.sock ] || fail
[ ! -S /var/run/docker.sock ] || fail
[ -r /sys/fs/cgroup/cgroup.controllers ] || fail
[ "$(cat /proc/1/cgroup)" = "0::/" ] || fail

cgroup_mount="$({ findmnt -rn -T /sys/fs/cgroup -o FSTYPE,TARGET,FSROOT; } \
    2>/dev/null)" || fail
set -- $cgroup_mount
[ "$#" -eq 3 ] || fail
[ "$1" = "cgroup2" ] || fail
[ "$2" = "/sys/fs/cgroup" ] || fail
case "$3" in
    /) ;;
    /system.slice/docker-*.scope)
        cgroup_id="${3#/system.slice/docker-}"
        cgroup_id="${cgroup_id%.scope}"
        [ "${#cgroup_id}" -eq 64 ] || fail
        case "$cgroup_id" in *[!0-9a-f]*) fail;; esac
        ;;
    *) fail ;;
esac

mount -o remount,rw,nosuid,nodev,noexec /sys/fs/cgroup || fail
case ",$(findmnt -rn -T /sys/fs/cgroup -o OPTIONS)," in
    *,rw,*) ;;
    *) fail ;;
esac

probe_cgroup=/sys/fs/cgroup/hepta-agent-os-entrypoint-probe
[ ! -e "$probe_cgroup" ] || fail
mkdir "$probe_cgroup" || fail
rmdir "$probe_cgroup" || fail

# /etc/heptatrader is an isolated tmpfs supplied by the outer runner.  Refuse
# to provision unless that fact is visible from the private mount namespace.
[ "$(findmnt -rn -T /etc/heptatrader -o FSTYPE,TARGET)" = \
    "tmpfs /etc/heptatrader" ] || fail
install -d -o 0 -g 0 -m 0755 /etc/heptatrader || fail
install -d -o 0 -g 0 -m 0700 /etc/heptatrader/credentials || fail
install -o 0 -g 0 -m 0644 \
    /usr/local/share/hepta-agent-os-e2e/provisioning/hepta-tool-gateway.env \
    /etc/heptatrader/hepta-tool-gateway.env || fail
install -o 0 -g 0 -m 0644 \
    /usr/local/share/hepta-agent-os-e2e/provisioning/hepta-execution-simulator.env \
    /etc/heptatrader/hepta-execution-simulator.env || fail
install -o 0 -g 0 -m 0600 \
    /usr/local/share/hepta-agent-os-e2e/provisioning/hepta-agent-trust-domain-paper-identities-v1.json \
    /etc/heptatrader/hepta-agent-trust-domain-paper-identities-v1.json || fail
install -o 0 -g 0 -m 0400 \
    /usr/local/share/hepta-agent-os-e2e/provisioning/hepta-execution-simulator-fence \
    /etc/heptatrader/credentials/hepta-execution-simulator-fence || fail
install -d -o 0 -g 0 -m 0755 \
    /etc/heptatrader/trust-domains || fail
install -o 0 -g 0 -m 0400 \
    /usr/local/share/hepta-agent-os-e2e/provisioning/full-trust-domain-chain.required \
    /etc/heptatrader/trust-domains/full-chain.required || fail
install -d -o 0 -g 0 -m 0700 \
    /etc/heptatrader/credentials/trust-domains || fail
for domain in codex-a openclaw-b; do
    case "$domain" in
        codex-a)
            agent_uid=2104
            agent_gid=2104
            reader_uid=2121
            reader_gid=2121
            ;;
        openclaw-b)
            agent_uid=2105
            agent_gid=2105
            reader_uid=2122
            reader_gid=2122
            ;;
        *) fail ;;
    esac
    install -d -o 0 -g 0 -m 0700 \
        "/etc/heptatrader/credentials/trust-domains/$domain" || fail
    install -o 0 -g 0 -m 0600 \
        "/usr/local/share/hepta-agent-os-e2e/provisioning/trust-domains/$domain.json" \
        "/etc/heptatrader/trust-domains/$domain.json" || fail
    install -o 0 -g "$agent_gid" -m 0640 \
        "/usr/local/share/hepta-agent-os-e2e/provisioning/trust-domains/uid-$agent_uid.json" \
        "/etc/heptatrader/trust-domains/uid-$agent_uid.json" || fail
    install -o 0 -g 0 -m 0644 \
        "/usr/local/share/hepta-agent-os-e2e/provisioning/trust-domains/$domain.env" \
        "/etc/heptatrader/trust-domains/$domain.env" || fail
    install -o 0 -g 0 -m 0644 \
        "/usr/local/share/hepta-agent-os-e2e/provisioning/trust-domains/$domain.execution.env" \
        "/etc/heptatrader/trust-domains/$domain.execution.env" || fail
    install -o 0 -g 0 -m 0644 \
        "/usr/local/share/hepta-agent-os-e2e/provisioning/trust-domains/$domain.agent-host.conf" \
        "/etc/heptatrader/trust-domains/$domain.agent-host.conf" || fail
    install -o 0 -g 0 -m 0600 \
        "/usr/local/share/hepta-agent-os-e2e/provisioning/trust-domains/$domain.shadow-watch.env" \
        "/etc/heptatrader/trust-domains/$domain.shadow-watch.env" || fail
    [ "$(sed -n 's/^HEPTA_SHADOW_READER_UID=//p' \
        "/etc/heptatrader/trust-domains/$domain.shadow-watch.env")" = \
        "$reader_uid" ] || fail
    [ "$(sed -n 's/^HEPTA_SHADOW_READER_GID=//p' \
        "/etc/heptatrader/trust-domains/$domain.shadow-watch.env")" = \
        "$reader_gid" ] || fail
    install -o 0 -g 0 -m 0400 \
        "/usr/local/share/hepta-agent-os-e2e/provisioning/$domain.execution-fence" \
        "/etc/heptatrader/credentials/trust-domains/$domain/hepta-execution-simulator-fence" || fail
done

umask 077
/usr/bin/python3 -c '
import os
paths = (
    "/etc/heptatrader/hepta-supervisor-lease.key",
    "/etc/heptatrader/credentials/trust-domains/codex-a/hepta-supervisor-lease.key",
    "/etc/heptatrader/credentials/trust-domains/openclaw-b/hepta-supervisor-lease.key",
)
for path in paths:
    fd = os.open(
        path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o400)
    try:
        value = os.urandom(32).hex().encode("ascii") + b"\n"
        if os.write(fd, value) != len(value):
            raise SystemExit(1)
        os.fsync(fd)
    finally:
        os.close(fd)
' || fail
chown 0:0 /etc/heptatrader/hepta-supervisor-lease.key || fail
chmod 0400 /etc/heptatrader/hepta-supervisor-lease.key || fail
for domain in codex-a openclaw-b; do
    lease="/etc/heptatrader/credentials/trust-domains/$domain/hepta-supervisor-lease.key"
    chown 0:0 "$lease" || fail
    chmod 0400 "$lease" || fail
done

sentinel=/run/hepta-agent-os-rootful-e2e.disposable
[ ! -e "$sentinel" ] || fail
printf '%s\n' "$run_id" >"$sentinel" || fail
chown 0:0 "$sentinel" || fail
chmod 0400 "$sentinel" || fail

exec /usr/lib/systemd/systemd \
    --unit=hepta-agent-os-rootful-e2e.target \
    --show-status=no
