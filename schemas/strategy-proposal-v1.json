{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrategyProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","proposal_id","module_id","module_version","sequence","capital_pool","account_book","snapshot","valid_from_ms","expires_at_ms","horizon_ms","candidates","numeric_policy_version"],
  "properties": {
    "schema": {"const":"hepta.strategy-proposal.v1"},
    "proposal_id": {"type":"string","minLength":1,"maxLength":128},
    "module_id": {"type":"string","pattern":"^hepta\\."},
    "module_version": {"type":"string"},
    "sequence": {"type":"integer","minimum":0},
    "capital_pool": {"type":"string"},
    "account_book": {"type":"string"},
    "snapshot": {"type":"object"},
    "valid_from_ms": {"type":"integer","minimum":0},
    "expires_at_ms": {"type":"integer","minimum":0},
    "horizon_ms": {"type":"integer","minimum":1},
    "candidates": {"type":"array","minItems":1,"maxItems":256,"items":{"type":"object"}},
    "numeric_policy_version": {"const":"hepta.numeric.fixed-v1"},
    "digests": {"type":"object"},
    "uncertainty": {"type":"object"},
    "factor_exposures": {"type":"object"},
    "capacity": {"type":"object"},
    "cost_curve": {"type":"array","maxItems":256}
  }
}
