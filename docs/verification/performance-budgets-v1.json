{
  "schema": "heptatrader.performance-budgets.v1",
  "policy": {
    "comparison": "same fixture and toolchain",
    "correctness_precedence": true,
    "baseline_change": "reviewed evidence required",
    "distribution_required": [
      "p50",
      "p95",
      "p99",
      "p999",
      "max"
    ],
    "allowed_states": [
      "declared",
      "implemented"
    ],
    "declared_claim_ceiling": "target only; cannot support a performance or readiness claim",
    "implemented_requires": [
      "executable same-revision fixture",
      "machine-bound threshold or bounded complexity contract",
      "recorded source, build and toolchain identity"
    ],
    "implemented_scopes": [
      "repository-ci",
      "bounded-complexity"
    ],
