{
  "schema": "heptatrader.module-manifest.v3",
  "id": "hepta.strategy.runtime",
  "version": "2.0.0",
  "lifecycle": "current",
  "kind": "sandbox-runtime",
  "trust_domain": "untrusted-strategy",
  "authority": "StrategyProposal only",
  "ownership_mode": "exclusive",
  "source_roots": [
    "HeptaTrade/strategy_runtime/"
  ],
  "build_targets": [
    "hepta_strategy_runtime"
  ],
  "provides": [
    "hepta.strategy-proposal.v1"
  ],
  "consumes": [
    "feature-snapshot.v1",
    "hepta.module-lifecycle.v1"
  ],
  "allowed_dependencies": [
    "hepta.protocol.contracts",
    "hepta.numeric.core"
  ],
  "forbidden_dependencies": [
    "hepta.execution.runtime",
    "hepta.venue.*",
    "broker.credentials"
  ],
  "state": {
    "model": "module-isolated",
    "persistence": "process-local-checkpoint-metadata-only",
    "writer": "single-owner"
  },
  "concurrency": {
    "model": "single-controller-mutex",
    "shard_key": "strategy-agent-instance",
    "blocking_io": "none-in-controller-payload-storage-external",
    "cross_module_lock": "forbidden"
  },
  "backpressure": {
    "class": "proposal-expiry",
    "overflow": "typed-failure"
  },
  "failure": {
    "risk_increase": "cannot-authorize",
    "safe_exit": "never-weaken"
  },
  "resource_budget": "strategy-v1",
  "owners": {
    "dri": "@hepta/strategy-platform",
    "backup": "@hepta/global-allocation",
    "reviewers": [
      "@hepta/security-runtime"
    ]
  },
  "verification": [
    "proposal-contracts",
    "strategy-isolation",
    "module-documentation-coverage"
  ],
  "documentation": {
    "technical_guide": "modules/technical/hepta-strategy-runtime.md",
    "coverage_topics": [
      "purpose-scope",
      "responsibilities-boundaries",
      "trust-authority",
      "source-build",
      "contracts-interfaces",
      "state-data",
      "concurrency-ordering-backpressure",
      "failure-recovery",
      "configuration-compatibility",
      "observability-resources",
      "security",
      "verification-testing",
      "operations-rollout-gaps"
    ]
  }
}
