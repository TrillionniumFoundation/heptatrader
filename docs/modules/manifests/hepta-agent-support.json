{
  "schema": "heptatrader.module-manifest.v3",
  "id": "hepta.agent.support",
  "version": "1.0.0",
  "lifecycle": "current",
  "kind": "support-library",
  "trust_domain": "trusted-local",
  "authority": "decision lease client and event hub",
  "ownership_mode": "exclusive",
  "source_roots": [
    "HeptaTrade/agent/",
    "HeptaTrade/events/"
  ],
  "build_targets": [
    "hepta_agent_execution_support"
  ],
  "provides": [
    "decision-lease.v1"
  ],
  "consumes": [
    "hepta.event-envelope.v1"
  ],
  "allowed_dependencies": [
    "hepta.protocol.contracts"
  ],
  "forbidden_dependencies": [
    "hepta.venue.*"
  ],
  "state": {
    "model": "bounded-local",
    "persistence": "process-local-reconstructible-cache",
    "writer": "single-owner"
  },
  "concurrency": {
    "model": "owner-sharded",
    "shard_key": "agent-session-owner",
    "blocking_io": "forbidden-on-event-dispatch",
    "cross_module_lock": "forbidden"
  },
  "backpressure": {
    "class": "bounded-event-buffer",
    "overflow": "typed-failure"
  },
  "failure": {
    "risk_increase": "lease-expiry-reject",
    "safe_exit": "never-weaken"
  },
  "resource_budget": "agent-support-v1",
  "owners": {
    "dri": "@hepta/agent-runtime",
    "backup": "@hepta/execution-core",
    "reviewers": [
      "@hepta/security-runtime"
    ]
  },
  "verification": [
    "lease-fencing",
    "event-ordering",
    "module-documentation-coverage"
  ],
  "documentation": {
    "technical_guide": "modules/technical/hepta-agent-support.md",
    "coverage_topics": [
      "purpose-scope",
      "responsibilities-boundaries",
      "trust-authority",
      "source-build",
      "contracts-interfaces",
      "state-data",
      "concurrency-ordering-backpressure",
      "failure-recovery",
      "configuration-compatibility",
      "observability-resources",
      "security",
      "verification-testing",
      "operations-rollout-gaps"
    ]
  }
}
