{
  "schema": "heptatrader.module-manifest.v2",
  "id": "hepta.research.protocol",
  "version": "1.0.0",
  "lifecycle": "current",
  "kind": "offline-runtime",
  "trust_domain": "capability-free-research",
  "authority": "deterministic replay only",
  "ownership_mode": "exclusive",
  "source_roots": [
    "research/"
  ],
  "build_targets": [],
  "provides": [
    "hepta.research-run.v1"
  ],
  "consumes": [],
  "allowed_dependencies": [],
  "forbidden_dependencies": [
    "hepta.execution.runtime",
    "broker.credentials"
  ],
  "state": {
    "model": "append-only-run",
    "persistence": "module-declared",
    "writer": "single-owner"
  },
  "concurrency": {
    "model": "run-isolated",
    "shard_key": "module-declared",
    "blocking_io": "declared-only",
    "cross_module_lock": "forbidden"
  },
  "backpressure": {
    "class": "offline-bounded",
    "overflow": "typed-failure"
  },
  "failure": {
    "risk_increase": "never-authorizes",
    "safe_exit": "never-weaken"
  },
  "resource_budget": "research-run-v1",
  "owners": {
    "dri": "@hepta/research-validation",
    "backup": "@hepta/data-platform",
    "reviewers": [
      "@hepta/security-runtime"
    ]
  },
  "verification": [
    "research-self-test",
    "point-in-time",
    "cost-model",
    "digest-parity"
  ]
}
