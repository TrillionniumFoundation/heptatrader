{
  "schema": "heptatrader.module-manifest.v3",
  "id": "hepta.feature.runtime",
  "version": "1.0.1",
  "lifecycle": "current",
  "kind": "data-plane",
  "trust_domain": "feature",
  "authority": "deterministic feature generations",
  "ownership_mode": "exclusive",
  "source_roots": [
    "HeptaTrade/features/"
  ],
  "build_targets": [
    "hepta_feature_runtime"
  ],
  "provides": [
    "feature-snapshot.v1"
  ],
  "consumes": [
    "market-event.v1"
  ],
  "allowed_dependencies": [
    "hepta.marketdata.runtime",
    "hepta.numeric.core"
  ],
  "forbidden_dependencies": [
    "hepta.execution.runtime",
    "hepta.venue.*"
  ],
  "state": {
    "model": "immutable-generation",
    "persistence": "derived-process-local-generation-cache",
    "writer": "single-owner"
  },
  "concurrency": {
    "model": "instrument-sharded",
    "shard_key": "venue-instrument-feature-set",
    "blocking_io": "forbidden-on-feature-compute",
    "cross_module_lock": "marketdata-feature-capability-transaction-only"
  },
  "backpressure": {
    "class": "bounded-coalescing",
    "overflow": "typed-failure"
  },
  "failure": {
    "risk_increase": "stale-reject",
    "safe_exit": "never-weaken"
  },
  "resource_budget": "feature-v1",
  "owners": {
    "dri": "@hepta/data-platform",
    "backup": "@hepta/research-validation",
    "reviewers": [
      "@hepta/architecture"
    ]
  },
  "verification": [
    "feature-determinism",
    "feature-generation",
    "module-documentation-coverage"
  ],
  "documentation": {
    "technical_guide": "modules/technical/hepta-feature-runtime.md",
    "coverage_topics": [
      "purpose-scope",
      "responsibilities-boundaries",
      "trust-authority",
      "source-build",
      "contracts-interfaces",
      "state-data",
      "concurrency-ordering-backpressure",
      "failure-recovery",
      "configuration-compatibility",
      "observability-resources",
      "security",
      "verification-testing",
      "operations-rollout-gaps"
    ]
  }
}
