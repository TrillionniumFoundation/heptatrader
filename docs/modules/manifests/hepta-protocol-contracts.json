{
  "schema": "heptatrader.module-manifest.v3",
  "id": "hepta.protocol.contracts",
  "version": "1.0.0",
  "lifecycle": "current",
  "kind": "contract-library",
  "trust_domain": "shared-trusted",
  "authority": "wire/codec",
  "ownership_mode": "exclusive",
  "source_roots": [
    "HeptaTrade/execution/execution_event_feed.cpp",
    "HeptaTrade/execution/execution_event_feed.h",
    "HeptaTrade/execution/execution_event_feed_contract.h",
    "HeptaTrade/execution/execution_event_feed_transport",
    "HeptaTrade/execution/execution_service_protocol",
    "HeptaTrade/execution/unix_execution_service_transport.cpp",
    "HeptaTrade/tool_host/typed_",
    "schemas/"
  ],
  "build_targets": [
    "hepta_execution_contract",
    "hepta_execution_transport",
    "hepta_tool_protocol"
  ],
  "provides": [
    "hepta.event-envelope.v1",
    "hepta.execution-wire.v1"
  ],
  "consumes": [],
  "allowed_dependencies": [
    "hepta.numeric.core"
  ],
  "forbidden_dependencies": [
    "hepta.venue.*"
  ],
  "state": {
    "model": "none",
    "persistence": "module-declared",
    "writer": "single-owner"
  },
  "concurrency": {
    "model": "pure-reentrant",
    "shard_key": "module-declared",
    "blocking_io": "declared-only",
    "cross_module_lock": "forbidden"
  },
  "backpressure": {
    "class": "caller-bounded",
    "overflow": "typed-failure"
  },
  "failure": {
    "risk_increase": "not-applicable",
    "safe_exit": "never-weaken"
  },
  "resource_budget": "contract-library-v1",
  "owners": {
    "dri": "@hepta/contracts",
    "backup": "@hepta/architecture",
    "reviewers": [
      "@hepta/execution-safety"
    ]
  },
  "verification": [
    "schema-catalog",
    "protocol-contracts",
    "module-documentation-coverage"
  ],
  "documentation": {
    "technical_guide": "modules/technical/hepta-protocol-contracts.md",
    "coverage_topics": [
      "purpose-scope",
      "responsibilities-boundaries",
      "trust-authority",
      "source-build",
      "contracts-interfaces",
      "state-data",
      "concurrency-ordering-backpressure",
      "failure-recovery",
      "configuration-compatibility",
      "observability-resources",
      "security",
      "verification-testing",
      "operations-rollout-gaps"
    ]
  }
}
