{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hepta ModuleManifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "lifecycle",
    "kind",
    "trust_domain",
    "authority",
    "ownership_mode",
    "source_roots",
    "build_targets",
    "provides",
    "consumes",
    "allowed_dependencies",
    "forbidden_dependencies",
    "state",
    "concurrency",
    "backpressure",
    "failure",
    "resource_budget",
    "owners",
    "verification"
  ],
  "properties": {
    "id": {"type":"string","pattern":"^hepta\\."},
    "version": {"type":"string"},
    "lifecycle": {"enum":["current","experimental","planned","unsupported","deprecated"]},
    "kind": {"type":"string"},
    "trust_domain": {"type":"string"},
    "authority": {"type":"string"},
    "ownership_mode": {"enum":["exclusive","shared-migration"]},
    "migration_gap": {"type":"string"},
    "source_roots": {"type":"array","items":{"type":"string"}},
    "build_targets": {"type":"array","items":{"type":"string"}},
    "provides": {"type":"array","items":{"type":"string"}},
    "consumes": {"type":"array","items":{"type":"string"}},
    "allowed_dependencies": {"type":"array","items":{"type":"string"}},
    "forbidden_dependencies": {"type":"array","items":{"type":"string"}},
    "state": {"type":"object","required":["model","persistence","writer"]},
    "concurrency": {"type":"object","required":["model","shard_key","blocking_io","cross_module_lock"]},
    "backpressure": {"type":"object","required":["class","overflow"]},
    "failure": {"type":"object","required":["risk_increase","safe_exit"]},
    "resource_budget": {"type":"string"},
    "owners": {"type":"object","required":["dri","backup","reviewers"]},
    "verification": {"type":"array","minItems":1,"items":{"type":"string"}}
  }
}
