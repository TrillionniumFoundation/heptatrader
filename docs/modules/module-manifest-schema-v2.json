{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heptatrader.local/schemas/module-manifest-v2.json",
  "title": "Hepta ModuleManifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "lifecycle",
    "kind",
    "trust_domain",
    "authority",
    "ownership_mode",
    "source_roots",
    "build_targets",
    "provides",
    "consumes",
    "allowed_dependencies",
    "forbidden_dependencies",
    "state",
    "concurrency",
    "backpressure",
    "failure",
    "resource_budget",
    "owners",
    "verification"
  ],
  "properties": {
    "schema": {"const": "heptatrader.module-manifest.v2"},
    "id": {
      "type": "string",
      "pattern": "^hepta(?:\\.[a-z0-9][a-z0-9-]*)+$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "maxLength": 64
    },
    "lifecycle": {
      "enum": ["current", "experimental", "planned", "unsupported", "deprecated"]
    },
    "kind": {"type": "string", "minLength": 1, "maxLength": 64},
    "trust_domain": {"type": "string", "minLength": 1, "maxLength": 64},
    "authority": {"type": "string", "minLength": 1, "maxLength": 256},
    "ownership_mode": {"enum": ["exclusive", "shared-migration"]},
    "migration_gap": {
      "type": "string",
      "pattern": "^G-[A-Z0-9-]+$",
      "maxLength": 64
    },
    "source_roots": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repositoryPath"}
    },
    "build_targets": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/targetName"}
    },
    "provides": {"$ref": "#/$defs/contractList"},
    "consumes": {"$ref": "#/$defs/contractList"},
    "allowed_dependencies": {"$ref": "#/$defs/dependencyList"},
    "forbidden_dependencies": {"$ref": "#/$defs/dependencyList"},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "persistence", "writer"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 96},
        "persistence": {"type": "string", "minLength": 1, "maxLength": 96},
        "writer": {"type": "string", "minLength": 1, "maxLength": 96}
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "shard_key", "blocking_io", "cross_module_lock"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 96},
        "shard_key": {"type": "string", "minLength": 1, "maxLength": 96},
        "blocking_io": {"type": "string", "minLength": 1, "maxLength": 96},
        "cross_module_lock": {"type": "string", "minLength": 1, "maxLength": 96}
      }
    },
    "backpressure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "overflow"],
      "properties": {
        "class": {"type": "string", "minLength": 1, "maxLength": 96},
        "overflow": {"type": "string", "minLength": 1, "maxLength": 96}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_increase", "safe_exit"],
      "properties": {
        "risk_increase": {"type": "string", "minLength": 1, "maxLength": 96},
        "safe_exit": {"type": "string", "minLength": 1, "maxLength": 96}
      }
    },
    "resource_budget": {"type": "string", "minLength": 1, "maxLength": 96},
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dri", "backup", "reviewers"],
      "properties": {
        "dri": {"$ref": "#/$defs/team"},
        "backup": {"$ref": "#/$defs/team"},
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/team"}
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "maxLength": 96
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"ownership_mode": {"const": "shared-migration"}}},
      "then": {"required": ["migration_gap"]},
      "else": {"not": {"required": ["migration_gap"]}}
    }
  ],
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.@+-]+(?:/[A-Za-z0-9_.@+-]+)*/?$"
    },
    "targetName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.+-]+$"
    },
    "contractId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.+-]+$"
    },
    "contractList": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/contractId"}
    },
    "dependencyList": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9_.+*-]+$"
      }
    },
    "team": {
      "type": "string",
      "pattern": "^@[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 128
    }
  }
}
