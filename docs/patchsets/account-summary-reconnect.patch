+bool HeptaIBGatewayAdapter::CanCancelOrder(long orderId, std::string* suppressReason) const {
+    auto it = m_orderLifecycle.find(orderId);
+    if (it == m_orderLifecycle.end()) {
+        if (suppressReason) *suppressReason = "NO_BROKER_SUBMIT";
+        return false;
+    }
+    const auto& life = it->second;
+    if (!life.sentToBroker) {
+        if (suppressReason) *suppressReason = "NO_BROKER_SUBMIT";
+        return false;
+    }
+    if (!life.brokerAck) {
+        if (suppressReason) *suppressReason = "NO_BROKER_ACK";
+        return false;
+    }
+    if (life.finalState) {
+        if (suppressReason) *suppressReason = "ALREADY_FINAL";
+        return false;
+    }
+    return true;
+}
