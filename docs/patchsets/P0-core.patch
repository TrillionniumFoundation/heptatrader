+static int GetEnvIntAlias(const char* primaryKey, const char* legacyKey, int defaultValue, std::string* usedKey = nullptr)
+{
+	const char* pPrimary = std::getenv(primaryKey);
+	if (pPrimary != nullptr && pPrimary[0] != '\0')
+	{
