+		return atoi(pPrimary);
+	}
+	const char* pLegacy = std::getenv(legacyKey);
+	if (pLegacy != nullptr && pLegacy[0] != '\0')
+	{
+		if (usedKey != nullptr) *usedKey = legacyKey;
+		return atoi(pLegacy);
+	}
+	if (usedKey != nullptr) *usedKey = "<default>";
+	return defaultValue;
+}
