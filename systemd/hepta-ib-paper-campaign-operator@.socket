[Unit]
Description=HeptaTrader bounded IB PAPER campaign operator socket (%i)
Documentation=file:/usr/share/doc/heptatrader/AGENT-NATIVE-TRADING-OS-ARCHITECTURE.md
BindsTo=hepta-ib-paper-domain-preflight@%i.service
After=hepta-ib-paper-domain-preflight@%i.service

[Socket]
ListenStream=/run/hepta-agent-%i/campaign.sock
FileDescriptorName=hepta-paper-campaign
SocketMode=0600
DirectoryMode=0711
SocketUser=hepta-agent-%i
SocketGroup=hepta-agent-%i
Service=hepta-ib-paper-campaign-operator@%i.service
RemoveOnStop=yes
