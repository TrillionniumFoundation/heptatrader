[Unit]
Description=Read-only stability checkpoint for local EURUSD PAPER trading
After=hepta-local-ai-paper-agent.service hepta-tool-gateway@alpha.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/libexec/hepta-local-paper-supervisor
TimeoutStartSec=45s
UMask=0077
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/hepta-local-ai-paper-agent
LockPersonality=yes
