# Non-secret Simulator execution profile. Install as
# /etc/heptatrader/hepta-execution-simulator.env with root ownership and mode
# 0644 only after replacing the deployment-specific gateway UID.
# Fence material must never be placed in this file.
# This fixed path belongs to explicit single-domain compatibility. Normal
# trust domains use the generated <domain>.execution.env bound to the exact
# hepta-gw-<domain> UID and domain Agent ID.
HEPTA_EXECUTION_GATEWAY_UID=2001
HEPTA_EXECUTION_GATEWAY_AGENT_ID=codex-agent-os-e2e
HEPTA_EXECUTION_MAX_REQUEST_BYTES=16384
HEPTA_EXECUTION_IO_TIMEOUT_MS=2500
