# Non-secret deterministic Simulator execution profile. Install as
# /etc/heptatrader/hepta-execution-simulator.env with root ownership and mode
# 0644 after replacing the deployment-specific Gateway UID and Agent ID.
# Fence material must never be placed in this file.
HEPTA_EXECUTION_GATEWAY_UID=2001
HEPTA_EXECUTION_GATEWAY_AGENT_ID=codex-agent-os-e2e
HEPTA_EXECUTION_MAX_REQUEST_BYTES=16384
HEPTA_EXECUTION_IO_TIMEOUT_MS=2500

# The Simulator and IB PAPER paths evaluate the same deterministic risk model.
# Venue-specific profiles may be stricter, but never weaker than these values.
HEPTA_SIM_ORDER_SUBMISSION_ENABLED=1
HEPTA_SIM_GLOBAL_KILL_SWITCH=0
HEPTA_SIM_FLATTEN_ONLY=0
HEPTA_SIM_MAX_ORDER_QTY=25000
HEPTA_SIM_MAX_ORDER_NOTIONAL=250000
HEPTA_SIM_MAX_ORDERS_PER_MINUTE=30
HEPTA_SIM_MAX_ACTIVE_ORDERS=50
HEPTA_SIM_MAX_GROSS_POSITION=100000
HEPTA_SIM_MAX_PRICE_DEVIATION_BPS=30
