[Unit]
Description=Renew the active local PAPER tool-session lease
After=hepta-tool-gateway@alpha.service
OnFailure=hepta-local-paper-safe-recover.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/libexec/hepta-local-paper-session-renew
TimeoutStartSec=60s
UMask=0077
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/hepta-local-ai-paper-agent -/run/hepta-agent-alpha
RestrictSUIDSGID=yes
LockPersonality=yes
