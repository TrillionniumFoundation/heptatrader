# Merge into the host's reviewed Prometheus configuration. Local-only example.
# Run node_exporter with --web.listen-address=127.0.0.1:19100
# --collector.textfile.directory=/var/lib/hepta-telemetry-simulator
# Choose ONE profile per output directory and one directory per exporter target.
global:
  scrape_interval: 5s
  evaluation_interval: 5s
rule_files:
  - /etc/prometheus/hepta.rules.yml
scrape_configs:
  - job_name: heptatrader
    static_configs:
      - targets: ['127.0.0.1:19100']
alerting:
  alertmanagers:
    - api_version: v2
      static_configs:
        - targets: ['127.0.0.1:19093']
