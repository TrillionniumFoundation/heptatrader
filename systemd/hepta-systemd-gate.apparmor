#
# AppArmor profile for disposable Hepta systemd rootful-gate containers.
#
# This profile is deliberately not installed or loaded automatically.  A root
# operator must review the exact source digest, compile it with the host parser,
# load it in the unstacked root AppArmor namespace, and publish the separate
# reviewed provenance consumed by the rootful-gate runners.
#
# The container runner supplies the primary boundary: network=none, a private
# cgroup namespace, no bind mounts/ports/devices, a read-only root filesystem,
# an exact tmpfs allowlist, no-new-privileges, and a bounded capability set.
# It is adapted from the Moby default container profile while giving the policy
# a unique, auditable name.  The loopback-only gate fixtures need AF_INET
# and AF_INET6, so network isolation remains the runner's independently checked
# responsibility.

abi <abi/3.0>,
#include <tunables/global>

profile hepta-systemd-gate flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  deny network alg,
  capability,
  file,
  umount,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=hepta-systemd-gate,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny @{PROC}/acpi/** rw,
  deny @{PROC}/scsi/** rw,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,tracedby,read,readby) peer=hepta-systemd-gate,
}
