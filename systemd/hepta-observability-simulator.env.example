# Optional overrides for hepta-observability-simulator.service.
# Keep the journal and outputs inside the hepta-exec-owned private state tree.
HEPTA_OMS_JOURNAL=/var/lib/hepta-execution/oms-journal.jsonl
HEPTA_METRICS_OUTPUT=/var/lib/hepta-execution/heptatrader.prom
HEPTA_ALERTS_OUTPUT=/var/lib/hepta-execution/heptatrader-alerts.json
