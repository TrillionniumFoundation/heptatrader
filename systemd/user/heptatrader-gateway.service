[Unit]
Description=HeptaTrader user Tool Gateway
Requires=heptatrader-runtime.service
After=heptatrader-runtime.service heptatrader-execution.service
PartOf=heptatrader.target
[Service]
Type=simple
ExecStart=%h/.local/share/heptatrader/current/bin/hepta-tool-gatewayd
EnvironmentFile=%h/.config/heptatrader/gateway.env
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
