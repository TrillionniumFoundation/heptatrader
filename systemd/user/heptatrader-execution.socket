[Unit]
RefuseManualStop=yes
Description=HeptaTrader user execution socket
Requires=heptatrader-runtime.service
After=heptatrader-runtime.service
[Socket]
ListenStream=%t/heptatrader/execution.sock
FileDescriptorName=execution
SocketMode=0600
DirectoryMode=0700
Service=heptatrader-execution.service
RemoveOnStop=yes
