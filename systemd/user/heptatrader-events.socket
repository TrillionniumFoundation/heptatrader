[Unit]
RefuseManualStop=yes
Description=HeptaTrader user events socket
Requires=heptatrader-runtime.service
After=heptatrader-runtime.service
[Socket]
ListenStream=%t/heptatrader/events.sock
FileDescriptorName=events
SocketMode=0600
DirectoryMode=0700
Service=heptatrader-execution.service
RemoveOnStop=yes
