[Unit]
Description=HeptaTrader bounded IB PAPER campaign operator (%i)
Documentation=file:/usr/share/doc/heptatrader/AGENT-NATIVE-TRADING-OS-ARCHITECTURE.md
Requires=hepta-ib-paper-campaign-operator@%i.socket
BindsTo=hepta-ib-paper-domain-preflight@%i.service
After=hepta-ib-paper-campaign-operator@%i.socket hepta-ib-paper-domain-preflight@%i.service

[Service]
Type=oneshot
User=root
Group=root
SupplementaryGroups=
ExecStart=/usr/libexec/hepta-ib-paper-campaign-operator --serve-once --domain %i
Sockets=hepta-ib-paper-campaign-operator@%i.socket
RuntimeDirectory=hepta/ib-paper-campaign hepta/ib-paper-one-shot
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=hepta/ib-paper-campaign hepta-ib-paper-one-shot
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=35s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service link linkat
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/heptatrader
ReadWritePaths=/run/hepta/ib-paper-control-%i /run/hepta/ib-paper-one-shot /var/lib/hepta-ib-paper-one-shot /run/hepta/ib-paper-campaign /var/lib/hepta/ib-paper-campaign
