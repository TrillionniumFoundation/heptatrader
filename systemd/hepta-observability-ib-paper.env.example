# Optional overrides for hepta-observability-ib-paper.service.
# Keep the journal and outputs inside the hepta-ib-exec-owned private state tree.
HEPTA_OMS_JOURNAL=/var/lib/hepta-ib-execution/oms-journal.jsonl
HEPTA_METRICS_OUTPUT=/var/lib/hepta-ib-execution/heptatrader.prom
HEPTA_ALERTS_OUTPUT=/var/lib/hepta-ib-execution/heptatrader-alerts.json
