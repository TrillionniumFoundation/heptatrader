{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "core-release",
      "displayName": "Core runtime (Release, IB disabled)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "HEPTA_INSTALL_RUNTIME": "ON",
        "HEPTA_ENABLE_IBAPI": "OFF"
      }
    },
    {
      "name": "core-debug",
      "displayName": "Core runtime (Debug, IB disabled)",
      "inherits": "core-release",
      "binaryDir": "${sourceDir}/build/core-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core-release",
      "configurePreset": "core-release",
      "targets": ["hepta_core_test_binaries", "hepta_runtime_binaries"]
    },
    {
      "name": "core-debug",
      "configurePreset": "core-debug",
      "targets": ["hepta_core_test_binaries", "hepta_runtime_binaries"]
    }
  ],
  "testPresets": [
    {
      "name": "core-release",
      "configurePreset": "core-release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "core"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "core-debug",
      "configurePreset": "core-debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "core"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
